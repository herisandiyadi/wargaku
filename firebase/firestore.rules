rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if caller is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user's role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'ADMIN';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read their own profile
      // ADMIN can read all
      allow read: if isOwner(userId) || isAdmin();

      // Only ADMIN can create/update users (via Cloud Function or direct)
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();

      // Only ADMIN can delete
      allow delete: if isAdmin();
    }

    // Panic Logs collection
    match /panic_logs/{panicId} {
      // Any authenticated user in the same RT can read panic logs
      allow read: if isAuth();

      // Any authenticated user can create a panic log (trigger SOS)
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(['user_id', 'lat', 'lng', 'status', 'rt_id'])
        && request.resource.data.user_id == request.auth.uid;

      // Only the creator or ADMIN can update (resolve)
      allow update: if isAuth()
        && (resource.data.user_id == request.auth.uid || isAdmin());

      // Only ADMIN can delete
      allow delete: if isAdmin();
    }
  }
}
